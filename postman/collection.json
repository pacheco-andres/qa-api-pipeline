              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Tiene id\", () => pm.expect(pm.response.json()).to.have.property(\"id\"));",
              "pm.test(\"El id es 1\", () => pm.expect(pm.response.json().id).to.eql(1));"
            ]
          }
        }
